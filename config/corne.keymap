#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/reset.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

&led_strip { chain-length = <27>; };

#define DEF 0
#define LWR 1
#define RSE 2
#define FLR 3
#define ADJ 4

&lt {
    /*quick_tap_ms = <219>;*/

    tapping-term-ms = <350>;
};

&mt {
    /*quick_tap_ms = <219>;*/

    tapping-term-ms = <350>;
    flavor = "tap-preferred";
};

/ {
    behaviors {
        tmux_leader: tmux_leader {
            compatible = "zmk,behavior-tap-dance";
            label = "TMUX_LEADER";
            #binding-cells = <0>;
            bindings = <&kp LCTRL>, <&kp LC(A)>;

            tapping-term-ms = <200>;
        };

        numbers_ht: numbers_ht {
            compatible = "zmk,behavior-hold-tap";
            label = "NUMBERS_HT";
            bindings = <&numbers_layer_wRGB>, <&general_layer_wRGB>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        raise_ht2: raise_ht2 {
            compatible = "zmk,behavior-hold-tap";
            label = "RAISE_HT2";
            bindings = <&raise_layer_wRGB>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        fbuttons_ht2: fbuttons_ht2 {
            compatible = "zmk,behavior-hold-tap";
            label = "FBUTTONS_HT2";
            bindings = <&fbuttons_layer_wRGB>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        ParaLeft {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <4 5>;
            timeout-ms = <20>;
        };

        ParaRight {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <6 7>;
            timeout-ms = <20>;
        };

        BrakLeft {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <16 17>;
            timeout-ms = <20>;
        };

        BrakRight {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <18 19>;
            timeout-ms = <20>;
        };

        BraceLeft {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <28 29>;
            timeout-ms = <20>;
        };

        BraceRight {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <30 31>;
            timeout-ms = <20>;
        };

        DoubleQuote {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <15 16>;
            timeout-ms = <20>;
        };

        SingleQuote {
            bindings = <&kp APOSTROPHE>;
            key-positions = <19 20>;
            timeout-ms = <20>;
        };

        //LangRu {
        //    bindings = <&kp LG(F11)>;
        //    key-positions = <0 1>;
        //    timeout-ms = <20>;
        //};
        //LangUs {
        //   bindings = <&kp LG(F12)>;
        //    key-positions = <10 11>;
        //    timeout-ms = <20>;
        //};
        //LangRuL {
        //    bindings = <&kp LG(F11)>;
        //    key-positions = <36 38>;
        //    timeout-ms = <20>;
        //};
        //LangUsL {
        //    bindings = <&kp LG(F12)>;
        //    key-positions = <39 41>;
        //    timeout-ms = <20>;
        //};

        TildaSign {
            bindings = <&kp TILDE>;
            key-positions = <0 12>;
            timeout-ms = <20>;
        };

        GraveSign {
            bindings = <&kp GRAVE>;
            key-positions = <12 24>;
            timeout-ms = <20>;
        };

        MinusSign {
            bindings = <&kp MINUS>;
            key-positions = <3 4>;
            timeout-ms = <20>;
        };

        PlusSign {
            bindings = <&kp PLUS>;
            key-positions = <2 3>;
            timeout-ms = <20>;
        };

        UnderscoreSign {
            bindings = <&kp UNDERSCORE>;
            key-positions = <7 8>;
            timeout-ms = <20>;
        };

        PipeSign {
            bindings = <&kp PIPE>;
            key-positions = <8 9>;
            timeout-ms = <20>;
        };

        Mainbootloaderleft {
            bindings = <&bootloader>;
            key-positions = <0 4>;
            timeout-ms = <20>;
        };

        Mainbootloaderright {
            bindings = <&bootloader>;
            key-positions = <7 11>;
            timeout-ms = <20>;
        };

        RALT_ALT {
            bindings = <&mt RALT C_PLAY_PAUSE>;
            key-positions = <13 25>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <14 15>;
            timeout-ms = <20>;
        };

        rgb_numbers_left {
            bindings = <&numbers_ht 0 0>;
            key-positions = <2 3 4>;
        };

        star {
            bindings = <&kp ASTERISK>;
            key-positions = <26 27>;
        };

        slash {
            bindings = <&kp SLASH>;
            key-positions = <27 28>;
        };

        comma {
            bindings = <&kp COMMA>;
            key-positions = <31 32>;
        };

        dot {
            bindings = <&kp DOT>;
            key-positions = <32 33>;
        };

        rgb_numbers_right {
            bindings = <&numbers_ht 0 0>;
            key-positions = <7 8 9>;
        };

        adjust_layer {
            bindings = <&adjust_layer_wRGB>;
            key-positions = <0 12 24>;
        };
    };
};

/ {
    macros {
        numbers_layer_wRGB: numbers_layer_wRGB_ON {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&to 5 &rgb_ug RGB_COLOR_HSB(111,100,5)>,
                <&macro_release>;

            label = "numbers_layer_wRGB_ON";
        };

        general_layer_wRGB: numbers_layer_wRGB_OFF {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&to 0 &rgb_ug RGB_COLOR_HSB(302,100,5)>,
                <&macro_release>;

            label = "numbers_layer_wRGB_OFF";
        };

        lower_layer_wRGB: lower_layer_wRGB {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&mo 1>,
                <&macro_tap>,
                <&rgb_ug RGB_COLOR_HSB(246,100,5)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 1>,
                <&macro_tap>,
                <&rgb_ug RGB_COLOR_HSB(302,100,5)>;

            label = "LOWER_LAYER_WRGB";
        };

        raise_layer_wRGB: raise_layer_wRGB {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&mo 2>,
                <&macro_tap>,
                <&rgb_ug RGB_COLOR_HSB(28,100,5)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 2>,
                <&macro_tap>,
                <&rgb_ug RGB_COLOR_HSB(302,100,5)>;

            label = "RAISE_LAYER_WRGB";
        };

        mic_toggle: mic_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(M)>;
            label = "MIC_TOGGLE";
        };

        bt_hds: bt_hds {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LG(P))>;
            label = "BT_HDS";
        };

        bt_mouse: bt_mouse {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LG(M))>;
            label = "BT_MOUSE";
        };

        fbuttons_layer_wRGB: fbuttons_layer_wRGB {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&mo 3>,
                <&macro_tap>,
                <&rgb_ug RGB_COLOR_HSB(170,100,5)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 3>,
                <&macro_tap>,
                <&rgb_ug RGB_COLOR_HSB(302,100,5)>;

            label = "FBUTTONS_LAYER_WRGB";
        };

        adjust_layer_wRGB: adjust_layer_wRGB {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&mo 4>,
                <&macro_tap>,
                <&rgb_ug RGB_COLOR_HSB(360,100,5)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 4>,
                <&macro_tap>,
                <&rgb_ug RGB_COLOR_HSB(302,100,5)>;

            label = "ADJUST_LAYER_WRGB";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC    &mt NUMBER_1 Q     &mt NUMBER_2 W  &mt NUMBER_3 E  &mt NUMBER_4 R     &mt NUMBER_5 T    &mt NUMBER_6 Y        &mt NUMBER_7 U   &mt NUMBER_8 I     &mt NUMBER_9 O  &mt NUMBER_0 P       &fbuttons_ht2 0 LEFT_BRACKET
&kp TAB    &mt EXCLAMATION A  &mt AT_SIGN S   &mt HASH D      &mt DOLLAR F       &mt PERCENT G     &mt CARET H           &mt AMPERSAND J  &mt ASTERISK K     &mt TILDE L     &mt SEMICOLON COLON  &mt DEL SQT
&kp LSHFT  &kp Z              &kp X           &kp C           &kp V              &kp B             &kp N                 &kp M            &kp COMMA          &kp DOT         &mt BACKSLASH FSLH   &mt RALT RIGHT_BRACKET
                                              &tmux_leader    &lower_layer_wRGB  &mt LGUI RET      &raise_ht2 RSE SPACE  &kp BSPC         &mt LGUI CAPSLOCK
            >;
        };

        lower_layer {
            bindings = <
&kp TILDE  &kp N1    &kp N2  &kp N3    &kp N4    &kp N5       &kp N6     &kp N7    &kp N8     &kp N9    &kp N0         &none
&kp GRAVE  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR       &none
&kp LSHFT  &trans    &trans  &trans    &trans    &trans       &trans     &trans    &trans     &trans    &kp BACKSLASH  &none
                             &trans    &trans    &kp LGUI     &trans     &trans    &trans
            >;
        };

        raise_layer {
            bindings = <
&trans        &trans  &kp PG_UP  &kp UP    &kp PG_DN    &kp HOME       &kp CARET  &kp PG_UP  &kp UP    &kp PG_DN  &kp HOME  &kp F17
&trans        &trans  &kp LEFT   &kp DOWN  &kp RIGHT    &kp END        &kp MINUS  &kp LEFT   &kp DOWN  &kp RIGHT  &kp END   &kp F18
&out OUT_TOG  &trans  &trans     &trans    &trans       &kp F15        &kp F16    &kp F23    &trans    &trans     &trans    &out OUT_TOG
                                 &trans    &kp LG(F11)  &kp LG(F12)    &trans     &trans     &trans
            >;
        };

        fbuttons_layer {
            bindings = <
&none  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5     &kp C_VOLUME_UP    &kp C_BRIGHTNESS_INC  &kp RCTRL  &bt_mouse  &bt_hds        &trans
&none  &kp F6   &kp F7   &kp F8   &kp F9   &kp F10    &kp C_VOLUME_DOWN  &kp C_BRIGHTNESS_DEC  &none      &none      &kp RIGHT_ALT  &none
&none  &kp F11  &kp F12  &kp F13  &kp F14  &kp F15    &kt K_MUTE         &mic_toggle           &none      &none      &none          &trans
                         &none    &none    &none      &none              &none                 &none
            >;
        };

        adjust_layer {
            bindings = <
&bootloader  &sys_reset    &out OUT_TOG  &none           &none         &ext_power EP_TOG    &rgb_ug RGB_TOG  &none            &none            &out OUT_TOG     &sys_reset  &bootloader
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4         &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &none       &none
&none        &none         &bt BT_CLR    &bt BT_CLR_ALL  &none         &kp KP_NUMLOCK       &rgb_ug RGB_EFR  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &none       &none
                                         &trans          &trans        &trans               &trans           &trans           &trans
            >;
        };

        numbers {
            bindings = <
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4   &kp NUMBER_5    &kp NUMBER_1  &kp NUMBER_2   &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &trans
&trans  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9   &kp NUMBER_0    &kp NUMBER_6  &kp NUMBER_7   &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &trans
&trans  &trans        &trans        &trans        &trans         &trans          &trans        &trans         &trans        &trans        &trans        &trans
                                    &trans        &kp BACKSPACE  &trans          &trans        &kp BACKSPACE  &trans
            >;
        };
    };
};
